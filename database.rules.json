{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": true,
      "$uid": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren() && (!newData.child('role').exists() || newData.child('role').isString())"
      }
    },
    "staffAccessRequests": {
      ".read": true,
      "$reqId": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "schools": {
      ".read": true,
      "$schoolId": {
        ".validate": "newData.hasChildren()"
      }
    },
    "elimupulse": {
      ".read": true,
      "learningAreaAssignments": {
        ".read": true,
        "$assignmentId": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "newData.hasChildren() && newData.child('id').isString() && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 300",
          "submissions": {
            ".read": true,
            "$learnerId": {
              ".read": true,
              ".write": "newData.exists()",
              ".validate": "newData.hasChildren() && newData.child('learnerId').isString() && newData.child('learnerName').isString() && newData.child('submittedAt').isString()"
            }
          }
        }
      }
    }
  }
}
